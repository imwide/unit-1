tnlnk[Mehr erfahren]{href=\"/ratgeber/top-kush-sorten\" color=#000000 bg=#ffffff colorHover=#ffffff bgHover=#000000} \n\n","color":"#FFFFFF","overlay":true,"video":{"data":null},"img":{"data":{"id":"11824","attributes":{"alternativeText":null,"width":1400,"height":280,"mime":"image/png","url":"https://assets-new.flowzz.com/4_09ef3d9a38.png","formats":{"small":{"ext":".png","url":"https://assets-new.flowzz.com/small_4_09ef3d9a38.png","hash":"small_4_09ef3d9a38","mime":"image/png","name":"small_4.png","path":null,"size":78.96,"width":400,"height":80,"sizeInBytes":78961,"isUrlSigned":true},"thumbnail":{"ext":".png","url":"https://assets-new.flowzz.com/thumbnail_4_09ef3d9a38.png","hash":"thumbnail_4_09ef3d9a38","mime":"image/png","name":"thumbnail_4.png","path":null,"size":30.59,"width":245,"height":49,"sizeInBytes":30590,"isUrlSigned":true}}}}},"imgmobile":{"data":{"id":"11832","attributes":{"alternativeText":null,"width":480,"height":480,"mime":"image/png","url":"https://assets-new.flowzz.com/4_70090e7931.png","formats":{"small":{"ext":".png","url":"https://assets-new.flowzz.com/small_4_70090e7931.png","hash":"small_4_70090e7931","mime":"image/png","name":"small_4.png","path":null,"size":395.36,"width":400,"height":400,"sizeInBytes":395359,"isUrlSigned":true},"thumbnail":{"ext":".png","url":"https://assets-new.flowzz.com/thumbnail_4_70090e7931.png","hash":"thumbnail_4_70090e7931","mime":"image/png","name":"thumbnail_4.png","path":null,"size":62.43,"width":156,"height":156,"sizeInBytes":62426,"isUrlSigned":true}}}}},"url":null,"target":"self","imgdisplay":"fixedheight","height":"480,480","mobiletextalign":"center","desktoptextalign":null,"autoplay":null},{"id":"1","column":"#### Top 10 Haze Sorten\n\nHaze. Ein Begriff, der heute gleichzeitig für Herkunft, Wirkung und eine der einflussreichsten Genetiken überhaupt steht. Dabei wird oft übersehen: Haze war nie klar definiert. Was unter diesem Namen läuft, ist kein klar abgegrenzter Strain, sondern ein gewachsenes Konzept – geprägt von Zucht, Markt und Interpretation.\n\n:btnlnk[Mehr erfahren]{href=\"/ratgeber/top-haze-sorten\" color=#000000 bg=#ffffff colorHover=#ffffff bgHover=#000000} ","color":"#FFFFFF","overlay":true,"video":{"data":null},"img":{"data":{"id":"11825","attributes":{"alternativeText":null,"width":1400,"height":280,"mime":"image/png","url":"https://assets-new.flowzz.com/5_b6af2536fd.png","formats":{"small":{"ext":".png","url":"https://assets-new.flowzz.com/small_5_b6af2536fd.png","hash":"small_5_b6af2536fd","mime":"image/png","name":"small_5.png","path":null,"size":73.18,"width":400,"height":80,"sizeInBytes":73183,"isUrlSigned":true},"thumbnail":{"ext":".png","url":"https://assets-new.flowzz.com/thumbnail_5_b6af2536fd.png","hash":"thumbnail_5_b6af2536fd","mime":"image/png","name":"thumbnail_5.png","path":null,"size":28.53,"width":245,"height":49,"sizeInBytes":28531,"isUrlSigned":true}}}}},"imgmobile":{"data":{"id":"11833","attributes":{"alternativeText":null,"width":480,"height":480,"mime":"image/png","url":"https://assets-new.flowzz.com/5_127c8cf19b.png","formats":{"small":{"ext":".png","url":"https://assets-new.flowzz.com/small_5_127c8cf19b.png","hash":"small_5_127c8cf19b","mime":"image/png","name":"small_5.png","path":null,"size":283.08,"width":400,"height":400,"sizeInBytes":283083,"isUrlSigned":true},"thumbnail":{"ext":".png","url":"https://assets-new.flowzz.com/thumbnail_5_127c8cf19b.png","hash":"thumbnail_5_127c8cf19b","mime":"image/png","name":"thumbnail_5.png","path":null,"size":46.52,"width":156,"height":156,"sizeInBytes":46522,"isUrlSigned":true}}}}},"url":null,"target":"self","imgdisplay":"fixedheight","height":"480,480","mobiletextalign":"center","desktoptextalign":null,"autoplay":null},{"id":"462","column":"#### Welche Cannabissorten zählen 2025 zu den beliebtesten?\n\nUnd was macht eine Sorte eigentlich so besonders, dass sie sich langfristig durchsetzt? Um diese Fragen zu beantworten, haben wir unsere Nutzungs- und Marktdaten aus dem Jahr 2025 ausgewertet.\n\n:btnlnk[Mehr erfahren]{href=\"/ratgeber/top-10-cannabissorten\" color=#000000 bg=#ffffff colorHover=#ffffff bgHover=#000000} ","color":"#ffffff","overlay":true,"video":{"data":null},"img":{"data":{"id":"11830","attributes":{"alternativeText":null,"width":1400,"height":280,"mime":"image/png","url":"https://assets-new.flowzz.com/1400_x_280_slim_header_28_faf4f7b4fb.png","formats":{"small":{"ext":".png","url":"https://assets-new.flowzz.com/small_1400_x_280_slim_header_28_faf4f7b4fb.png","hash":"small_1400_x_280_slim_header_28_faf4f7b4fb","mime":"image/png","name":"small_1400 x 280 slim header (28).png","path":null,"size":78.02,"width":400,"height":80,"sizeInBytes":78017,"isUrlSigned":true},"thumbnail":{"ext":".png","url":"https://assets-new.flowzz.com/thumbnail_1400_x_280_slim_header_28_faf4f7b4fb.png","hash":"thumbnail_1400_x_280_slim_header_28_faf4f7b4fb","mime":"image/png","name":"thumbnail_1400 x 280 slim header (28).png","path":null,"size":30.68,"width":245,"height":49,"sizeInBytes":30683,"isUrlSigned":true}}}}},"imgmobile":{"data":{"id":"11831","attributes":{"alternativeText":null,"width":480,"height":480,"mime":"image/png","url":"https://assets-new.flowzz.com/6_e9c78f666e.png","formats":{"small":{"ext":".png","url":"https://assets-new.flowzz.com/small_6_e9c78f666e.png","hash":"small_6_e9c78f666e","mime":"image/png","name":"small_6.png","path":null,"size":346.57,"width":400,"height":400,"sizeInBytes":346573,"isUrlSigned":true},"thumbnail":{"ext":".png","url":"https://assets-new.flowzz.com/thumbnail_6_e9c78f666e.png","hash":"thumbnail_6_e9c78f666e","mime":"image/png","name":"thumbnail_6.png","path":null,"size":59.35,"width":156,"height":156,"sizeInBytes":59346,"isUrlSigned":true}}}}},"url":null,"target":"self","imgdisplay":"fixedheight","height":"480,480","mobiletextalign":"center","desktoptextalign":null,"autoplay":true}]},{"__typename":"ComponentSectionsC2","id":"6","content":"#### Wie erkenne ich hochwertige Cannabisblüten?\n\nUm Qualität wirklich einschätzen zu können, lohnt sich ein genauer Blick auf die wichtigsten Merkmale. Wir haben die zentralen Kriterien übersichtlich zusammengefasst, damit du Unterschiede in Aussehen, Struktur und Reifegrad besser einordnen kannst.\n::br\n[weiterlesen](/ratgeber/cannabis-qualitaet-erkennen)","imgPos":"right","bgcolor":"#f4f5f9","txtcolor":null,"video":{"data":null},"autoplay":null,"img":{"data":{"id":"8618","attributes":{"alternativeText":null,"width":1280,"height":736,"mime":"image/png","url":"https://assets-new.flowzz.com/1280_x_736_C2_Modul_81_3fa266195f.png","formats":{"small":{"ext":".png","url":"https://assets-new.flowzz.com/small_1280_x_736_C2_Modul_81_3fa266195f.png","hash":"small_1280_x_736_C2_Modul_81_3fa266195f","mime":"image/png","name":"small_1280 x 736 C2 Modul (81).png","path":null,"size":220.84,"width":400,"height":230,"sizeInBytes":220842,"isUrlSigned":true},"thumbnail":{"ext":".png","url":"https://assets-new.flowzz.com/thumbnail_1280_x_736_C2_Modul_81_3fa266195f.png","hash":"thumbnail_1280_x_736_C2_Modul_81_3fa266195f","mime":"image/png","name":"thumbnail_1280 x 736 C2 Modul (81).png","path":null,"size":85.52,"width":245,"height":141,"sizeInBytes":85515,"isUrlSigned":true}}}}}},{"__typename":"ComponentSectionsC2","id":"7","content":"#### Cannabis auf Rezept aus der Apotheke: So leicht kann es gehen\nDer erste Schritt zu medizinischem Cannabis wirkt oft kompliziert: Ärzte, Rezepte, Krankenkasse, Apotheke – schnell verliert man den Überblick. Unser Guide erklärt den gesamten Prozess klar und verständlich. \n::br\n[Step-by-Step Guide](/patient-werden)","imgPos":"left","bgcolor":"#f4f5f9","txtcolor":null,"video":{"data":null},"autoplay":null,"img":{"data":{"id":"6171","attributes":{"alternativeText":null,"width":1280,"height":736,"mime":"image/png","url":"https://assets-new.flowzz.com/1280_x_736_C2_Modul_2_326ecfc2b5.png","formats":{"small":{"ext":".png","url":"https://assets-new.flowzz.com/small_1280_x_736_C2_Modul_2_326ecfc2b5.png","hash":"small_1280_x_736_C2_Modul_2_326ecfc2b5","mime":"image/png","name":"small_1280 x 736 C2 Modul (2).png","path":null,"size":139.61,"width":400,"height":230,"sizeInBytes":139609,"isUrlSigned":true},"thumbnail":{"ext":".png","url":"https://assets-new.flowzz.com/thumbnail_1280_x_736_C2_Modul_2_326ecfc2b5.png","hash":"thumbnail_1280_x_736_C2_Modul_2_326ecfc2b5","mime":"image/png","name":"thumbnail_1280 x 736 C2 Modul (2).png","path":null,"size":59.14,"width":245,"height":141,"sizeInBytes":59136,"isUrlSigned":true}}}}}},{"__typename":"ComponentSectionsC10","id":"1","content":"#### Du willst die Preise der Cannabis Apotheken sehen und vergleichen?\n\nEs gibt bei den spezialisierten Cannabis Apotheken große Preisunterschiede – einfach anmelden und alle unterschiedlichen Preise vergleichen. \n\n[Jetzt anmelden](/register)","txtcolor":null,"bgcolor":"#f4f5f9","authenticated":"UNAUTHENTICATED"},{"__typename":"ComponentSectionsC14","id":"1","content":"##### Ratgeber zur Cannabis Apotheke, Cannabis Ärzten und Telemedizin\n\nWir helfen dir die richtige Cannabis Apotheke, Arzt oder Telemedizin Klinik zu finden. Alle Tipps zu Cannabis auf Rezept und vieles mehr in unserem umfangreichen Ratgeber!\n\n\n\n","columns":[{"id":"42","column":"[Liste der spezialisierten Cannabis Ärzt\\:innen in Deutschland](/ratgeber/cannabis-arzt)\n","color":null,"img":{"data":{"id":"9885","attributes":{"alternativeText":null,"width":1280,"height":736,"mime":"image/png","url":"https://assets-new.flowzz.com/13_058337179f.png","formats":{"small":{"ext":".png","url":"https://assets-new.flowzz.com/small_13_058337179f.png","hash":"small_13_058337179f","mime":"image/png","name":"small_13.png","path":null,"size":11.78,"width":400,"height":230,"sizeInBytes":11776,"isUrlSigned":true},"thumbnail":{"ext":".png","url":"https://assets-new.flowzz.com/thumbnail_13_058337179f.png","hash":"thumbnail_13_058337179f","mime":"image/png","name":"thumbnail_13.png","path":null,"size":5.73,"width":245,"height":141,"sizeInBytes":5731,"isUrlSigned":true}}}}},"imgUrl":null},{"id":"43","column":"[Cannabis Telemedizin-Kliniken Preisvergleich](/ratgeber/cannabis-telemedizin)\n","color":null,"img":{"data":{"id":"9884","attributes":{"alternativeText":null,"width":1280,"height":736,"mime":"image/png","url":"https://assets-new.flowzz.com/14_38a68e1db8.png","formats":{"small":{"ext":".png","url":"https://assets-new.flowzz.com/small_14_38a68e1db8.png","hash":"small_14_38a68e1db8","mime":"image/png","name":"small_14.png","path":null,"size":7.02,"width":400,"height":230,"sizeInBytes":7018,"isUrlSigned":true},"thumbnail":{"ext":".png","url":"https://assets-new.flowzz.com/thumbnail_14_38a68e1db8.png","hash":"thumbnail_14_38a68e1db8","mime":"image/png","name":"thumbnail_14.png","path":null,"size":3.91,"width":245,"height":141,"sizeInBytes":3909,"isUrlSigned":true}}}}},"imgUrl":null},{"id":"44","column":"[Cannabis Apotheken Vergleich: Lokal- oder Online-Apotheke?](/ratgeber/cannabis-apotheken)\n","color":null,"img":{"data":{"id":"9883","attributes":{"alternativeText":null,"width":1280,"height":736,"mime":"image/png","url":"https://assets-new.flowzz.com/15_88e43e2958.png","formats":{"small":{"ext":".png","url":"https://assets-new.flowzz.com/small_15_88e43e2958.png","hash":"small_15_88e43e2958","mime":"image/png","name":"small_15.png","path":null,"size":8.58,"width":400,"height":230,"sizeInBytes":8583,"isUrlSigned":true},"thumbnail":{"ext":".png","url":"https://assets-new.flowzz.com/thumbnail_15_88e43e2958.png","hash":"thumbnail_15_88e43e2958","mime":"image/png","name":"thumbnail_15.png","path":null,"size":4.85,"width":245,"height":141,"sizeInBytes":4852,"isUrlSigned":true}}}}},"imgUrl":null}],"styles":null,"bgcolor":null},{"__typename":"ComponentSectionsS1","id":"6","container":"Newsletter"},{"__typename":"ComponentSectionsC1","id":"194","content":"###### Willkommen bei flowzz  – deinem Wegweiser für die Cannabis Apotheke\nflowzz ist deine erste Anlaufstelle für Informationen, Beratung und Preisvergleiche einer Cannabis Apotheke. Finde die perfekte Cannabis Apotheke für Dein Rezept und deine individuellen Bedürfnisse.\n::br\n###### flowzz - dein Partner bei der Auswahl der richtigen Apotheke\nAuf flowzz erwartet dich eine benutzerfreundliche Plattform, die es dir ermöglicht, mühelos Produkte \u0026 Preise in der Apotheke zu vergleichen. Unser Fokus liegt darauf, dir Transparenz und umfassende Informationen über das Sortiment einer Cannabis Apotheke zu bieten, damit du die bestmöglichen Entscheidungen für deine Gesundheit treffen kannst.\n::br\n###### Warum mit flowzz die Preise in der Apotheke vergleichen?\n**Umfassende Auswahl:** Durchstöber eine breite Palette von medizinischen Cannabisprodukten, die von spezialisierten Cannabisapotheken angeboten werden. Egal, ob du nach spezifischen Blüten, Extrakten oder Strains aus der Apotheke für Dein Rezept suchst – bei uns wirst du fündig.\n:br\n**Transparente Informationen:** Erfahre alles über die angebotenen Produkte, Preise und Bewertungen direkt auf unserer Plattform. Wir setzen auf klare und verständliche Informationen, damit du die für dich passende Cannabis Apotheke findest.\n:br\n**Bewertungen und Empfehlungen:** Vertraue auf die Erfahrungen anderer Nutzer. Unsere Plattform bietet dir die Möglichkeit, Bewertungen zu lesen und sich auf diese Weise ein umfassendes Bild von den verschiedenen Blüten und  Cannabis Apotheken zu machen.\n:br\n**Aktuelle Angebote aus der Apotheke:** Bleibe stets informiert über Sonderangebote, Rabatte und Aktionen. flowzz hält dich auf dem Laufenden, damit du von den besten Deals aus der Apotheke profitieren kannst.\n::br\nEntdecke wie leicht es ist auf flowzz die Preise der Apotheke zu vergleichen. Wir sind stolz darauf, dir eine Plattform zu bieten, die auf **Qualität**, **Transparenz** und **Kundenfreundlichkeit** basiert. \n::br\n###### flowzz - legales, medizinisches Cannabis aus der Apotheke\n_Finde mit flowzz deine ideale Apotheke, deine Lieblingsblüte, das richtige Extrakt oder den perfekten Strain!_","style":null,"bgcolor":null}],"metadata":{"metaTitle":"flowzz - Der Nr. 1 Preisvergleich: Cannabis Apotheke \u0026 Rezept","metaDescription":"Cannabisblüten ab 2,99 €/gr  ✔ über 2.500 Blüten ✔ über 400 Apotheken ✔ einfach \u0026 schnell zum Cannabis Rezept ▶ Jetzt vergleichen \u0026 sparen!","noindex":false,"nofollow":false,"canonicalUrl":"https://flowzz.com/","shareImage":{"data":{"id":"1171","attributes":{"alternativeText":"flowzz | Der Nr. 1 Preisvergleich: Cannabis Apotheke \u0026 Rezept","width":1200,"height":628,"mime":"image/png","url":"https://assets-new.flowzz.com/cms/47e78f9d8a0697105dcabd38c64c88ce.png","formats":{"small":{"ext":".png","url":"https://assets-new.flowzz.com/cms/e03138e0036fa60bdc1ce43b94623151.png","hash":"e03138e0036fa60bdc1ce43b94623151","mime":"image/png","name":"small_flowzz-logo-grün-transparent","path":null,"size":8.34,"width":400,"height":209},"thumbnail":{"ext":".png","url":"https://assets-new.flowzz.com/cms/ed2bb89949346278a783ab78bed93b94.png","hash":"ed2bb89949346278a783ab78bed93b94","mime":"image/png","name":"thumbnail_flowzz-logo-grün-transparent","path":null,"size":5.27,"width":245,"height":128}}}}}},"breadcrumb":null,"pageContext":{"locale":"de","locales":["de"],"defaultLocale":"de","slug":"","localizations":{"data":[]},"newsletter":false,"productFilterData":null,"strainAttributes":[{"id":"41","labelDE":"Trockener Mund","type":"sideEffects","order":450},{"id":"40","labelDE":"Trockene Augen","type":"sideEffects","order":442},{"id":"44","labelDE":"Paranoid","type":"sideEffects","order":430},{"id":"45","labelDE":"Schwindel","type":"sideEffects","order":426},{"id":"32","labelDE":"Würzig","type":"taste","order":325},{"id":"25","labelDE":"Fruchtig","type":"taste","order":324},{"id":"22","labelDE":"Süß","type":"taste","order":316},{"id":"31","labelDE":"Citrus","type":"taste","order":313},{"id":"28","labelDE":"Holzig","type":"taste","order":312},{"id":"39","labelDE":"Erdig","type":"taste","order":310},{"id":"23","labelDE":"Blumen","